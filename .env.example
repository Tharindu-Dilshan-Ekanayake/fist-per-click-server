# Local development only. Copy to `.env` and edit; `.env` is gitignored, this is not.
#
# Nothing here is needed in production. Bloxity Legion injects its own values at
# runtime (see the bottom of this file).

# Port to listen on. Legion and most hosts set this for you - leave it unset there.
PORT=3000

# Extra browser origins allowed to open a lobby socket or call the API, comma
# separated. The two Vite dev origins are built in (see src/server.js), every
# *.bloxity.io page is trusted (see src/realtime.js), and on Legion the game's own
# address arrives as CLIENT_ORIGIN - so this is only for the ones none of those cover.
#
# ALLOWED_ORIGINS=https://my-own-domain.com,http://192.168.1.5:5173

# A MongoDB to keep saves in. Without it they live in memory and are
# gone when the server stops - fine for trying things out. On Legion this is set for
# you to the game's own isolated database.
# MONGODB_URI=mongodb://localhost:27017/1-fist-per-click

# The slug the game is registered under on bloxity.io, if it is not the same string
# as its hosting id (BLOXITY_GAME_ID). Used to verify players' game tokens.
# BLOXITY_GAME_SLUG=1-fist-per-click

# Players one pod holds. Must equal `seatCap` in .github/workflows/deploy.yml.
# SEAT_CAP=50

# --- What the platform sets, and what must never be written here -----------------
#
# Bloxity Legion provides these to the running container; do not hardcode or
# duplicate them:
#
#   PORT  NODE_ENV  CLIENT_ORIGIN  JWT_SECRET  MONGODB_URI
#   BLOXITY_GAME_ID  BLOXITY_CHANNEL  POD_NAME
#
# The deploy token is NOT one of them. It is a credential that pushes code to the
# live game, and it belongs in this repository's GitHub Actions secrets as
# LEGION_DEPLOY_TOKEN - nowhere else. This file is committed, so a token written
# here is a token published. If one ever does land here, deleting the line is not
# enough: regenerate the token on the Bloxity hosting page, because the old one is
# in the git history for good.
